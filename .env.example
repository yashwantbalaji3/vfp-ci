# Names only. Never commit real values. Local values come from `pnpm db:start` output.
NEXT_PUBLIC_APP_NAME="Vegetarian Food Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEFAULT_MARKET=boston
PUBLIC_RELEASE_ENABLED=false
SOCIAL_PUBLIC_ENABLED=false
ALLOW_DEMO_CONTENT=false
# Server-only (no NEXT_PUBLIC_ prefix). Used by tests and future restricted workers, never member requests.
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Server-only random string (16+ characters) used to hash network addresses for rate limiting.
RATE_LIMIT_SALT=
# Server-only random string (32+ characters). Its SHA-256 digest must be registered in app.server_keys on each
# database (locally the seed does it; on a hosted database a migration-time step, never the seed). Without it,
# rate-limited requests are refused with a 503.
RATE_LIMIT_KEY=
# The one request header the host guarantees carries the visitor's address (on Vercel: x-vercel-forwarded-for,
# to verify on Vercel's docs). Unset = every visitor shares one rate-limit allowance.
TRUSTED_ADDRESS_HEADER=
# Release and preview flags: each is off unless exactly "true". Production default for every one: unset/false.
MAP_ENABLED=false
REAL_CATALOG_PREVIEW=false
REAL_DISCOVERY=false
PARTNER_SUBMISSIONS=false
# Test-only names. They must never be set on a hosted deployment.
# ALLOW_FAULT_TEST, SIGNIN_LIMIT_SCALE, MAP_STREET_FILE
