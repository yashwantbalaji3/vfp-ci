{
  "name": "vegetarian-food-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-map-worker.mjs && next dev",
    "local:doctor": "node scripts/local-doctor.mjs",
    "local:update": "node scripts/local-update.mjs",
    "build": "node scripts/copy-map-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:rls": "vitest run --project rls",
    "test:e2e": "playwright test --trace off",
    "test:e2e:real": "playwright test --config playwright.real.config.ts --trace off",
    "db:start": "supabase start && node scripts/write-local-env.mjs",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm test:rls && pnpm build",
    "map:demo": "node scripts/map-demo.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "decimal.js": "10.6.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.6",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "supabase": "3.1.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
