# Production (hosted, invite-only beta) settings: NAMES and SAFE VALUES only. Never commit a real secret.
# Set each in Vercel > Project > Settings > Environment Variables, for the Production environment only.
# Preview and Development environments get NO database or Supabase values (docs/75, docs/77).
# Check with: node scripts/release-preflight.mjs --env-file <a local copy of these values>

NEXT_PUBLIC_APP_NAME="Vegetarian Food Platform"
# The exact https://<name>.vercel.app address. Also the Supabase Site URL and the only redirect allowed.
NEXT_PUBLIC_APP_URL=
# From the hosted Supabase project (Settings > API). The publishable key is meant for browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DEFAULT_MARKET=boston

# Server-only secrets: generate fresh random values for production, never reuse local ones.
# RATE_LIMIT_SALT: 16+ characters. RATE_LIMIT_KEY: 32+ characters; register its SHA-256 digest in app.server_keys.
RATE_LIMIT_SALT=
RATE_LIMIT_KEY=
# The request header Vercel guarantees carries the visitor's address (name to confirm in Vercel's docs).
TRUSTED_ADDRESS_HEADER=

# Not set in production: the app never uses these for member requests.
# SUPABASE_SECRET_KEY, DATABASE_URL

# Release flags: every one off for the invite-only beta.
PUBLIC_RELEASE_ENABLED=false
SOCIAL_PUBLIC_ENABLED=false
ALLOW_DEMO_CONTENT=false
MAP_ENABLED=false
# true only if the owner decides testers may see real (unverified) menus (docs/77 decision 3).
REAL_CATALOG_PREVIEW=false
REAL_DISCOVERY=false
PARTNER_SUBMISSIONS=false

# Test-only: must be absent in production. ALLOW_FAULT_TEST, SIGNIN_LIMIT_SCALE, MAP_STREET_FILE
