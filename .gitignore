# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template is safe to commit (names only)
!.env.example
!.env.production.example

# test output and scratch
/test-results/
/playwright-report/
/work/
supabase/.temp/
supabase/.branches/

# map worker copied from node_modules at build time (scripts/copy-map-worker.mjs)
/public/vendor/

# The full street-map file (MAP-1.1): OpenStreetMap data, tens of MB, never committed (docs/21).
/local-maps/
*.pmtiles
!/tests/fixtures/maps/*.pmtiles
.next-real/
.next-foundation/
